# ==============================================================================
# TrustCert Environment Configuration Template
# Copy this file to .env and configure your local settings.
# DO NOT commit real .env files with credentials or keys to version control!
# ==============================================================================

# Application Environment
APP_NAME="TrustCert"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/TrustCert/public

# Database Configuration (MySQL / MariaDB on XAMPP or Docker)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trustcert_db
DB_USER=root
DB_PASS=

# Cryptographic Storage Configuration
# Paths are relative to the includes/ or root execution directory
AES_KEY_PATH=../storage/keys/aes_key.bin
KEYS_DIR=../storage/keys/
UPLOADS_DIR=../storage/uploads/

